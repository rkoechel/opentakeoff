{
  "name": "floor360-takeoff-runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FLOOR360 auto-takeoff worker for the DGX Spark: a headless job API around the OpenTakeoff MCP engine. Off unless RUNNER_ENABLED=1.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "node --import tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "test": "node --import tsx --test --test-timeout=120000 test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "fast-uri": "^3.1.4",
    "@hono/node-server": "^2.0.5"
  }
}
