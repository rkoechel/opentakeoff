# /etc/takeoff-runner.env  (owner root, mode 0600; read by docker --env-file)
# Example only: no real values. README.md has the install steps.

# Off until Ryan turns it on. Anything but 1 answers every job route with 503.
RUNNER_ENABLED=0
# The bearer token Bids sends (Authorization: Bearer ...). Generate on the
# Spark with `openssl rand -hex 32`; the same value goes into Bids as
# AUTO_TAKEOFF_RUNNER_TOKEN (Key Vault). Never paste it into chat.
RUNNER_TOKEN=

# Inside the container. The host publishes 127.0.0.1:8014 only.
RUNNER_HOST=0.0.0.0
RUNNER_PORT=8014
RUNNER_DATA_DIR=/var/lib/takeoff-runner
# RUNNER_CONCURRENCY=1   fixed: one job at a time; any other value is ignored
# RUNNER_JOB_TIMEOUT_MIN=60
# RUNNER_RETENTION_DAYS=7
# RUNNER_VERDICT_MIN_CONFIDENCE=0.9
# RUNNER_DPI=200

# The existing takeoff-vision model and its waker. Use an address the
# container can reach (README.md "Networking"): the tailnet address, or
# host.docker.internal with --add-host=host.docker.internal:host-gateway,
# or 127.0.0.1 with the host-network variant.
VISION_BASE_URL=http://127.0.0.1:8010/v1
# A file holding the vLLM --api-key (mounted read-only); never the key itself.
VISION_API_KEY_FILE=/run/secrets/takeoff-vision.key
# VISION_MODEL=        unset: the first id /v1/models lists
WAKER_URL=http://127.0.0.1:8012
# A file holding the waker's WAKER_TOKEN (mounted read-only).
WAKER_TOKEN_FILE=/run/secrets/takeoff-waker.token
# NO_MEMORY_RETRY_MIN=15
# NO_MEMORY_MAX_MIN=240
