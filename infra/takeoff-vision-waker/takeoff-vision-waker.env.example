# /etc/takeoff-vision-waker.env  (owner root, group takeoff-waker, mode 0640)
# WAKER_TOKEN: a long random value (e.g. `openssl rand -hex 32`). The same
# value goes into the OpenTakeoff App Service setting WAKER_TOKEN (Key Vault).
WAKER_TOKEN=
MEM_THRESHOLD_GB=17
WAKER_HOST=127.0.0.1
WAKER_PORT=8012
HEALTH_URL=http://127.0.0.1:8010/health
WAKE_COOLDOWN_S=30
WAKER_USE_SUDO=1
