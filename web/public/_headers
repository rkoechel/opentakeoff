# Security response headers. Netlify applies this file to every response.
# This is the ONE Netlify CSP — do not also add a [[headers]] block in
# netlify.toml. Two CSP headers on the same response are each enforced
# (an intersection) and a second, older policy will silently punch holes
# back out of this one.
#
# FLOOR360 private build. The same policy is in staticwebapp.config.json
# and scripts/floor360-static.mjs. A test asserts the three strings match.
# App Service does not read this file; the Node static server sends it.
#
# script-src is this origin plus 'wasm-unsafe-eval'. pdf.js compiles a
# JPEG2000 wasm codec; that keyword allows wasm compilation only, not
# eval(). worker-src is this origin plus blob: for the pdf.js worker.
# connect-src is 'self' plus blob: and data: so pdf.js can read a blob
# or data document URL. There is no analytics host, no font CDN, and no
# Google sign-in frame. style-src keeps 'unsafe-inline' because the
# canvas sets style in React. Do not add 'unsafe-inline' to script-src.
#
# On-device OCR is off in this build (VITE_OCR=off). If it were on, its
# worker, wasm, and models would still be same-origin files.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' blob: data:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # microphone=(self): push-to-talk dictation stays on-device. The private
  # CSP blocks a remote speech endpoint anyway.
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000
